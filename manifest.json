{
  "manifest_version": 3,
  "name": "SOCKS5 Proxy Switcher",
  "version": "1.1",
  "description": "SOCKS5 прокси с вводом логина/пароля",
  "permissions": ["proxy", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOCKS5 Proxy"
  },
  "web_accessible_resources": [{
    "resources": ["popup.js"],
    "matches": ["<all_urls>"]
  }]
}
